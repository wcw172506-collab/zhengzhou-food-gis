# 依赖
node_modules/
**/node_modules/

# 构建产物
dist/
**/dist/
build/
**/build/

# 数据库文件（云平台启动时会从 CSV 自动导入）
backend/data/*.db
backend/data/*.db-shm
backend/data/*.db-wal

# 嵌套的旧 backend 目录
backend/backend/

# 环境变量
.env
.env.local
.env.*.local
!.env.example

# 日志
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 编辑器
.vscode/
.idea/
*.swp
*.swo

# 系统
.DS_Store
Thumbs.db

# TypeScript 构建缓存
*.tsbuildinfo

# Vite 缓存
.vite/

# 临时文件
*.tmp
*.bak

# 原始数据目录（CSV 已复制到 backend/data/csv/ 供云平台导入）
数据/

# Word 文档（体积较大，不放仓库；保留 .md 文档即可）
*.docx

# Vite 构建缓存
frontend/.tsbuildinfo
frontend/tsconfig.tsbuildinfo
